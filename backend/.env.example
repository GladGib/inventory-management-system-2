# =============================================================================
# IMS Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Required variables are marked with [REQUIRED].

# -- Database ------------------------------------------------------------------
# [REQUIRED] PostgreSQL connection string
DATABASE_URL="postgresql://ims_user:ims_password@localhost:5432/ims_db?schema=public"

# -- Authentication ------------------------------------------------------------
# [REQUIRED] Secret key for signing JWTs (use a long random string in production)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# JWT access token expiration (default: 15m)
JWT_EXPIRATION=15m

# Refresh token expiration (default: 7d)
REFRESH_TOKEN_EXPIRATION=7d

# -- Server --------------------------------------------------------------------
# Port the API server listens on (default: 3001)
PORT=3001

# Comma-separated list of allowed CORS origins (default: http://localhost:3000)
CORS_ORIGIN="http://localhost:3000"

# Directory for file uploads (default: ./uploads)
UPLOAD_DIR=./uploads

# Node environment: development | production | test
NODE_ENV=development

# -- Email (SMTP) --------------------------------------------------------------
# SMTP server hostname
SMTP_HOST=

# SMTP server port (default: 587)
SMTP_PORT=587

# SMTP authentication username
SMTP_USER=

# SMTP authentication password
SMTP_PASS=

# Sender address for outgoing emails
SMTP_FROM="noreply@ims.local"
